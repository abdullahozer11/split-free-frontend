{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/api/**/*.ts",
    "src/api/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/database.types.ts",
    "src/constants/**/*.ts",
    "src/utils/expenseFormDefaults.ts",
    "src/utils/expense_categories.ts",
    "src/utils/helpers.ts",
    "src/log.ts",
    "src/translations/**/*.ts",
    "src/providers/**/*.ts",
    "src/providers/**/*.tsx",
    "src/components/Translated.tsx",
    "src/components/Button.tsx",
    "src/components/KeyboardAvoidingScreen.tsx",
    "src/components/CollapsibleHeader.tsx",
    "src/components/CustomHeader.tsx",
    "src/components/Debug.tsx",
    "src/components/DropdownComponent.tsx",
    "src/components/ExpenseItem.tsx",
    "src/components/GroupItem.tsx",
    "src/components/MultiSelectComponent.tsx",
    "src/components/Person.tsx",
    "src/components/TransferItem.tsx",
    "src/components/UnderlinedText.tsx",
    "src/components/useClientOnlyValue.ts",
    "src/components/useClientOnlyValue.web.ts",
    "src/components/ExpenseForm.tsx",
    "src/modals/**/*.ts",
    "src/modals/**/*.tsx",
    "src/app/(auth)/**/*.ts",
    "src/app/(auth)/**/*.tsx",
    "src/app/(global)/**/*.ts",
    "src/app/(global)/**/*.tsx",
    "src/app/(tabs)/account/**/*.ts",
    "src/app/(tabs)/account/**/*.tsx",
    "src/app/(tabs)/_layout.tsx",
    "src/app/(tabs)/friend.tsx",
    "src/app/(tabs)/group/_layout.tsx",
    "src/app/(tabs)/group/index.tsx",
    "src/app/(tabs)/group/[group_id]/_layout.tsx",
    "src/app/(tabs)/group/[group_id]/details.tsx",
    "src/app/(tabs)/group/[group_id]/expense/**/*.ts",
    "src/app/(tabs)/group/[group_id]/expense/**/*.tsx",
    "src/app/(tabs)/group/[group_id]/transfer/**/*.ts",
    "src/app/(tabs)/group/[group_id]/transfer/**/*.tsx",
    "src/app/(tabs)/group/[group_id]/member/_layout.tsx",
    "src/app/(tabs)/group/[group_id]/member/[member_id]/_layout.tsx",
    "src/app/_layout.tsx",
    "src/app/index.tsx",
    "src/app/join.tsx",
    "src/app/+not-found.tsx",
    "src/app/+html.tsx",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
